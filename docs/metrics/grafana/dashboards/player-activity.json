{
  "uid": "yvtils-player-activity",
  "title": "YVtils — Player Activity",
  "tags": ["minecraft", "yvtils", "players"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {"list": [
    {"name": "instance", "label": "Server", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": "label_values(yvtils_players_online, instance)", "refresh": 1, "includeAll": true, "allValue": ".*"}
  ]},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Online and unique players", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_players_online{instance=~\"$instance\"}", "legendFormat": "Online — {{instance}}"}, {"refId": "B", "expr": "yvtils_players_unique{instance=~\"$instance\",period=\"day\"}", "legendFormat": "Unique today — {{instance}}"}, {"refId": "C", "expr": "yvtils_players_unique{instance=~\"$instance\",period=\"month\"}", "legendFormat": "Unique this month — {{instance}}"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 2, "type": "timeseries", "title": "Ping percentiles", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.5, sum by (instance,le) (rate(yvtils_player_ping_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p50 — {{instance}}"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (instance,le) (rate(yvtils_player_ping_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p95 — {{instance}}"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}},
    {"id": 3, "type": "timeseries", "title": "Session duration percentiles", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.5, sum by (instance,le) (rate(yvtils_player_session_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p50 — {{instance}}"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (instance,le) (rate(yvtils_player_session_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p95 — {{instance}}"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}},
    {"id": 4, "type": "timeseries", "title": "Departures and kicks per hour", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "rate(yvtils_player_departures_total{instance=~\"$instance\"}[$__rate_interval]) * 3600", "legendFormat": "Departures — {{instance}}"}, {"refId": "B", "expr": "rate(yvtils_player_kicks_total{instance=~\"$instance\"}[$__rate_interval]) * 3600", "legendFormat": "Kicks — {{instance}} {{cause}}"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 5, "type": "timeseries", "title": "Online players by game mode", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_players_by_gamemode{instance=~\"$instance\"}", "legendFormat": "{{instance}} — {{gamemode}}"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 6, "type": "timeseries", "title": "Online players by world", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_world_players_online{instance=~\"$instance\"}", "legendFormat": "{{instance}} — {{world}}"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 7, "type": "timeseries", "title": "AFK and high-ping players", "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_players_afk{instance=~\"$instance\"}", "legendFormat": "AFK — {{instance}}"}, {"refId": "B", "expr": "yvtils_players_high_ping{instance=~\"$instance\"}", "legendFormat": "Ping >250ms — {{instance}}"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 8, "type": "stat", "title": "Total online", "gridPos": {"x": 12, "y": 24, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(yvtils_players_online{instance=~\"$instance\"})", "instant": true}]},
    {"id": 9, "type": "stat", "title": "Total AFK", "gridPos": {"x": 18, "y": 24, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(yvtils_players_afk{instance=~\"$instance\"})", "instant": true}]}
  ]
}
