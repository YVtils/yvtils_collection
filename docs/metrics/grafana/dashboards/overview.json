{
  "uid": "yvtils-minecraft",
  "title": "YVtils — Minecraft Overview",
  "tags": ["minecraft", "yvtils", "prometheus"],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "15s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": [
    {"name": "instance", "label": "Server", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": "label_values(yvtils_players_online, instance)", "refresh": 1, "includeAll": true, "allValue": ".*"}
  ]},
  "panels": [
    {"id": 1, "type": "stat", "title": "Online / capacity", "gridPos": {"x": 0, "y": 0, "w": 5, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_players_online{instance=~\"$instance\"}", "instant": true}, {"refId": "B", "expr": "yvtils_players_capacity{instance=~\"$instance\"}", "instant": true}], "options": {"textMode": "value_and_name"}},
    {"id": 2, "type": "stat", "title": "Collection ready (1=yes)", "gridPos": {"x": 5, "y": 0, "w": 4, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_collection_ready{instance=~\"$instance\"}", "instant": true}]},
    {"id": 3, "type": "stat", "title": "Storage healthy (1=yes)", "gridPos": {"x": 9, "y": 0, "w": 4, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_storage_healthy{instance=~\"$instance\"}", "instant": true}]},
    {"id": 4, "type": "stat", "title": "Maintenance (1=on)", "gridPos": {"x": 13, "y": 0, "w": 4, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_maintenance{instance=~\"$instance\"}", "instant": true}]},
    {"id": 5, "type": "stat", "title": "Process uptime", "gridPos": {"x": 17, "y": 0, "w": 7, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_process_uptime_seconds{instance=~\"$instance\"}", "instant": true}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"id": 6, "type": "timeseries", "title": "Players online and unique visits", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_players_online{instance=~\"$instance\"}", "legendFormat": "Online — {{instance}}"}, {"refId": "B", "expr": "yvtils_players_unique{instance=~\"$instance\",period=\"day\"}", "legendFormat": "Unique today — {{instance}}"}, {"refId": "C", "expr": "yvtils_players_unique{instance=~\"$instance\",period=\"month\"}", "legendFormat": "Unique this month — {{instance}}"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 7, "type": "timeseries", "title": "TPS", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_server_tps{instance=~\"$instance\"}", "legendFormat": "{{instance}} — {{window}}"}], "fieldConfig": {"defaults": {"min": 0, "max": 20}, "overrides": []}},
    {"id": 8, "type": "timeseries", "title": "Tick duration and heartbeat", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_tick_duration_average_seconds{instance=~\"$instance\"}", "legendFormat": "Average — {{instance}}"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (instance,le) (rate(yvtils_server_tick_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p95 — {{instance}}"}, {"refId": "C", "expr": "time() - yvtils_tick_heartbeat_seconds{instance=~\"$instance\"}", "legendFormat": "Heartbeat age — {{instance}}"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}},
    {"id": 9, "type": "timeseries", "title": "JVM heap", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_jvm_heap_bytes{instance=~\"$instance\"}", "legendFormat": "{{instance}} — {{kind}}"}], "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}},
    {"id": 10, "type": "timeseries", "title": "Gameplay activity per hour", "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (instance) (rate(yvtils_players_blocks_broken_total{instance=~\"$instance\"}[$__rate_interval])) * 3600", "legendFormat": "Mined — {{instance}}"}, {"refId": "B", "expr": "sum by (instance) (rate(yvtils_players_blocks_placed_total{instance=~\"$instance\"}[$__rate_interval])) * 3600", "legendFormat": "Placed — {{instance}}"}, {"refId": "C", "expr": "sum by (instance) (rate(yvtils_players_deaths_total{instance=~\"$instance\"}[$__rate_interval])) * 3600", "legendFormat": "Deaths — {{instance}}"}, {"refId": "D", "expr": "sum by (instance) (rate(yvtils_players_mob_kills_total{instance=~\"$instance\"}[$__rate_interval])) * 3600", "legendFormat": "Mob kills — {{instance}}"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 11, "type": "timeseries", "title": "Players by game mode", "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_players_by_gamemode{instance=~\"$instance\"}", "legendFormat": "{{instance}} — {{gamemode}}"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 12, "type": "table", "title": "World snapshot", "gridPos": {"x": 0, "y": 28, "w": 24, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_world_players_online{instance=~\"$instance\"}", "instant": true, "format": "table"}, {"refId": "B", "expr": "yvtils_world_chunks_loaded{instance=~\"$instance\"}", "instant": true, "format": "table"}, {"refId": "C", "expr": "yvtils_world_entities_loaded{instance=~\"$instance\"}", "instant": true, "format": "table"}, {"refId": "D", "expr": "yvtils_world_block_entities_loaded{instance=~\"$instance\"}", "instant": true, "format": "table"}], "transformations": [{"id": "labelsToFields", "options": {"mode": "columns"}}]}
  ]
}
