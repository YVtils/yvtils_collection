{
  "uid": "yvtils-server-health",
  "title": "YVtils — Server Health",
  "tags": ["minecraft", "yvtils", "health"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": [
    {"name": "instance", "label": "Server", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": "label_values(yvtils_players_online, instance)", "refresh": 1, "includeAll": true, "allValue": ".*"}
  ]},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "TPS moving averages", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_server_tps{instance=~\"$instance\"}", "legendFormat": "{{instance}} — {{window}}"}], "fieldConfig": {"defaults": {"min": 0, "max": 20}, "overrides": []}},
    {"id": 2, "type": "timeseries", "title": "Tick duration and slow ticks", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_tick_duration_average_seconds{instance=~\"$instance\"}", "legendFormat": "Average — {{instance}}"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (instance,le) (rate(yvtils_server_tick_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p95 — {{instance}}"}, {"refId": "C", "expr": "yvtils_tick_duration_max_seconds{instance=~\"$instance\"}", "legendFormat": "Recent max — {{instance}}"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}},
    {"id": 3, "type": "timeseries", "title": "Slow tick counts per minute", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "rate(yvtils_server_slow_ticks_total{instance=~\"$instance\"}[$__rate_interval]) * 60", "legendFormat": "{{instance}} — >{{threshold_seconds}}s"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 4, "type": "timeseries", "title": "JVM heap", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_jvm_heap_bytes{instance=~\"$instance\"}", "legendFormat": "{{instance}} — {{kind}}"}], "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}},
    {"id": 5, "type": "timeseries", "title": "Process CPU and garbage collection", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_process_cpu_ratio{instance=~\"$instance\"}", "legendFormat": "CPU ratio — {{instance}}"}, {"refId": "B", "expr": "rate(yvtils_jvm_gc_seconds_total{instance=~\"$instance\"}[$__rate_interval])", "legendFormat": "GC seconds/second — {{instance}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": [{"matcher": {"id": "byName", "options": "GC seconds/second — .*"}, "properties": [{"id": "unit", "value": "s"}]}]}},
    {"id": 6, "type": "timeseries", "title": "Loaded chunks and entities by world", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_world_chunks_loaded{instance=~\"$instance\"}", "legendFormat": "{{instance}} — {{world}} chunks"}, {"refId": "B", "expr": "yvtils_world_entities_loaded{instance=~\"$instance\"}", "legendFormat": "{{instance}} — {{world}} entities"}, {"refId": "C", "expr": "yvtils_world_block_entities_loaded{instance=~\"$instance\"}", "legendFormat": "{{instance}} — {{world}} block entities"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 7, "type": "timeseries", "title": "Storage refresh age", "gridPos": {"x": 0, "y": 24, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "time() - yvtils_storage_last_success_seconds{instance=~\"$instance\"}", "legendFormat": "{{instance}}"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}},
    {"id": 8, "type": "timeseries", "title": "Tick heartbeat age", "gridPos": {"x": 8, "y": 24, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "time() - yvtils_tick_heartbeat_seconds{instance=~\"$instance\"}", "legendFormat": "{{instance}}"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}},
    {"id": 9, "type": "timeseries", "title": "High-ping and AFK players", "gridPos": {"x": 16, "y": 24, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_players_high_ping{instance=~\"$instance\"}", "legendFormat": "High ping — {{instance}}"}, {"refId": "B", "expr": "yvtils_players_afk{instance=~\"$instance\"}", "legendFormat": "AFK — {{instance}}"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 10, "type": "table", "title": "Process and Minecraft versions", "gridPos": {"x": 0, "y": 31, "w": 24, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_server_version_info{instance=~\"$instance\"}", "instant": true, "format": "table"}], "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "job": true, "Value": true}, "renameByName": {"instance": "Server", "minecraft": "Minecraft", "paper_api": "Paper API"}}}]}
  ]
}
