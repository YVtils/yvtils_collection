{
  "uid": "yvtils-gameplay",
  "title": "YVtils — Gameplay",
  "tags": ["minecraft", "yvtils", "gameplay"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {"list": [
    {"name": "instance", "label": "Server", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": "label_values(yvtils_players_online, instance)", "refresh": 1, "includeAll": true, "allValue": ".*"}
  ]},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Block actions per hour", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "rate(yvtils_players_blocks_broken_total{instance=~\"$instance\"}[$__rate_interval]) * 3600", "legendFormat": "Mined — {{instance}}"}, {"refId": "B", "expr": "rate(yvtils_players_blocks_placed_total{instance=~\"$instance\"}[$__rate_interval]) * 3600", "legendFormat": "Placed — {{instance}}"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 2, "type": "timeseries", "title": "Deaths and kills per hour", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "rate(yvtils_players_deaths_total{instance=~\"$instance\"}[$__rate_interval]) * 3600", "legendFormat": "Deaths — {{instance}}"}, {"refId": "B", "expr": "rate(yvtils_players_mob_kills_total{instance=~\"$instance\"}[$__rate_interval]) * 3600", "legendFormat": "Mobs — {{instance}}"}, {"refId": "C", "expr": "rate(yvtils_players_monster_kills_total{instance=~\"$instance\"}[$__rate_interval]) * 3600", "legendFormat": "Monsters — {{instance}}"}, {"refId": "D", "expr": "rate(yvtils_players_animal_kills_total{instance=~\"$instance\"}[$__rate_interval]) * 3600", "legendFormat": "Other mobs — {{instance}}"}, {"refId": "E", "expr": "rate(yvtils_players_player_kills_total{instance=~\"$instance\"}[$__rate_interval]) * 3600", "legendFormat": "Players — {{instance}}"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 3, "type": "timeseries", "title": "Player totals — crafting, food and fishing", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_players_items_crafted_total{instance=~\"$instance\"}", "legendFormat": "Items crafted — {{instance}}"}, {"refId": "B", "expr": "yvtils_players_food_eaten_total{instance=~\"$instance\"}", "legendFormat": "Food eaten — {{instance}}"}, {"refId": "C", "expr": "yvtils_players_fish_caught_total{instance=~\"$instance\"}", "legendFormat": "Fish caught — {{instance}}"}, {"refId": "D", "expr": "yvtils_players_items_enchanted_total{instance=~\"$instance\"}", "legendFormat": "Items enchanted — {{instance}}"}, {"refId": "E", "expr": "yvtils_players_totems_used_total{instance=~\"$instance\"}", "legendFormat": "Totems used — {{instance}}"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 4, "type": "timeseries", "title": "Player totals — raids, breeding and trading", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_players_raids_won_total{instance=~\"$instance\"}", "legendFormat": "Raids won — {{instance}}"}, {"refId": "B", "expr": "yvtils_players_animals_bred_total{instance=~\"$instance\"}", "legendFormat": "Animals bred — {{instance}}"}, {"refId": "C", "expr": "yvtils_players_villager_trades_total{instance=~\"$instance\"}", "legendFormat": "Villager trades — {{instance}}"}, {"refId": "D", "expr": "yvtils_players_chests_opened_total{instance=~\"$instance\"}", "legendFormat": "Chests opened — {{instance}}"}, {"refId": "E", "expr": "yvtils_players_bells_rung_total{instance=~\"$instance\"}", "legendFormat": "Bells rung — {{instance}}"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 5, "type": "timeseries", "title": "Movement distance by type", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_players_walk_distance_meters_total{instance=~\"$instance\"}", "legendFormat": "Walk — {{instance}}"}, {"refId": "B", "expr": "yvtils_players_swim_distance_meters_total{instance=~\"$instance\"}", "legendFormat": "Swim — {{instance}}"}, {"refId": "C", "expr": "yvtils_players_fly_distance_meters_total{instance=~\"$instance\"}", "legendFormat": "Fly — {{instance}}"}, {"refId": "D", "expr": "yvtils_players_vehicle_distance_meters_total{instance=~\"$instance\"}", "legendFormat": "Vehicle — {{instance}}"}, {"refId": "E", "expr": "yvtils_players_other_distance_meters_total{instance=~\"$instance\"}", "legendFormat": "Climb — {{instance}}"}, {"refId": "F", "expr": "yvtils_players_fall_distance_meters_total{instance=~\"$instance\"}", "legendFormat": "Fall — {{instance}}"}], "fieldConfig": {"defaults": {"unit": "lengthm", "min": 0}, "overrides": []}},
    {"id": 6, "type": "timeseries", "title": "Damage dealt and taken (hearts)", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_players_damage_dealt_health_points_total{instance=~\"$instance\"} / 2", "legendFormat": "Dealt — {{instance}}"}, {"refId": "B", "expr": "yvtils_players_damage_taken_health_points_total{instance=~\"$instance\"} / 2", "legendFormat": "Taken — {{instance}}"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}},
    {"id": 7, "type": "timeseries", "title": "Advancements, jumps and world changes", "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_players_advancements_total{instance=~\"$instance\"}", "legendFormat": "Advancements — {{instance}}"}, {"refId": "B", "expr": "yvtils_players_jumps_total{instance=~\"$instance\"}", "legendFormat": "Jumps — {{instance}}"}, {"refId": "C", "expr": "yvtils_players_dimension_changes_total{instance=~\"$instance\"}", "legendFormat": "World changes — {{instance}}"}, {"refId": "D", "expr": "yvtils_players_joins_total{instance=~\"$instance\"}", "legendFormat": "Sessions joined — {{instance}}"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 8, "type": "timeseries", "title": "Item movement and time", "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "yvtils_players_items_picked_up_total{instance=~\"$instance\"}", "legendFormat": "Picked up — {{instance}}"}, {"refId": "B", "expr": "yvtils_players_items_dropped_total{instance=~\"$instance\"}", "legendFormat": "Dropped — {{instance}}"}, {"refId": "C", "expr": "yvtils_players_sneak_seconds_total{instance=~\"$instance\"} / 3600", "legendFormat": "Sneaking hours — {{instance}}"}, {"refId": "D", "expr": "yvtils_players_afk_seconds_total{instance=~\"$instance\"} / 3600", "legendFormat": "Observed AFK hours — {{instance}}"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 9, "type": "stat", "title": "Lifetime playtime (hours)", "gridPos": {"x": 0, "y": 32, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(yvtils_players_playtime_seconds_total{instance=~\"$instance\"}) / 3600", "instant": true}], "fieldConfig": {"defaults": {"unit": "suffix: h", "decimals": 1}, "overrides": []}},
    {"id": 10, "type": "stat", "title": "Lifetime total blocks", "gridPos": {"x": 6, "y": 32, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(yvtils_players_blocks_broken_total{instance=~\"$instance\"}) + sum(yvtils_players_blocks_placed_total{instance=~\"$instance\"})", "instant": true}]},
    {"id": 11, "type": "stat", "title": "Lifetime jumps", "gridPos": {"x": 12, "y": 32, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(yvtils_players_jumps_total{instance=~\"$instance\"})", "instant": true}]},
    {"id": 12, "type": "stat", "title": "Lifetime totems used", "gridPos": {"x": 18, "y": 32, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(yvtils_players_totems_used_total{instance=~\"$instance\"})", "instant": true}]}
  ]
}
