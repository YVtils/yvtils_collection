# Credentials for publishing YVtils module artifacts to the self-hosted Reposilite
# Maven registry. Copy this file to `.env`, fill in the real values, and NEVER commit
# the resulting `.env` file (it is already covered by .gitignore).
#
# Load it into your shell before running a publish task, e.g.:
#   set -a; source .env; set +a
#   ./gradlew publish
#
# In CI (e.g. GitHub Actions), set these as repository/environment secrets instead
# of committing a .env file, and export them as environment variables for the job step
# that runs `./gradlew publish`.

# Base URL of the "releases" repository on the Reposilite instance.
REPOSILITE_URL=https://reposilite-registry.yvtils.net/releases

# Access token generated in Reposilite, scoped to write-only access on /releases:
#   token-generate ci-publisher
#   route-add ci-publisher /releases w
REPOSILITE_USERNAME=ci-publisher
REPOSILITE_TOKEN=
